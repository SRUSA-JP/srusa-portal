{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u30db\u30fc\u30e0","text":"<p>SRUSA \u306e\u60c5\u5831\u3092\u307e\u3068\u3081\u308b\u30dd\u30fc\u30bf\u30eb\u30b5\u30a4\u30c8\u3067\u3059\u3002</p> <p>\u73fe\u5728\u3001\u30b5\u30a4\u30c8\u306e\u5185\u5bb9\u3092\u6e96\u5099\u3057\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"#_2","title":"\u30b3\u30f3\u30c6\u30f3\u30c4","text":"<ul> <li>\u767b\u5c71\u90e8</li> <li>Minecraft \u30b5\u30fc\u30d0\u30fc\u7d71\u8a08</li> <li>\u76f8\u95a2\u56f3</li> </ul>"},{"location":"minecraft/","title":"Minecraft \u30b5\u30fc\u30d0\u30fc\u7d71\u8a08","text":"<p>2026\u5e748\u670818\u65e5\u6642\u70b9\u306e\u30b5\u30fc\u30d0\u30fc\u7d71\u8a08\uff08\u30d7\u30ec\u30a4\u30e4\u30fc15\u4eba\u5206\uff09\u3067\u3059\u3002\u30b0\u30e9\u30d5\u306f\u6307\u6a19\u3092\u5207\u308a\u66ff\u3048\u306a\u304c\u3089\u898b\u3089\u308c\u307e\u3059\u3002\u8aad\u307f\u65b9\u3068\u64cd\u4f5c\u306f\u30b0\u30e9\u30d5\u306e\u4e0b\u306b\u307e\u3068\u3081\u3066\u3044\u307e\u3059\u3002</p> <p>\u8a66\u9a13\u7684\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u3067\u3059\u3002 \u63b2\u8f09\u306e\u53ef\u5426\u3001\u30bf\u30d6\u540d\u3001\u516c\u958b\u7bc4\u56f2\u306f\u307e\u3060\u6c7a\u307e\u3063\u3066\u3044\u307e\u305b\u3093\u3002</p> <p>\u30d3\u30e5\u30fc\u30a2\u3092\u5358\u72ec\u3067\u958b\u304f \u30fb \u6a19\u6e96\u306e\u898b\u305f\u76ee\u3067\u958b\u304f</p>"},{"location":"minecraft/#_1","title":"\u4f7f\u3044\u65b9","text":"<p>\u30b0\u30e9\u30d5\u306f 4 \u7a2e\u985e\u3042\u308a\u3001\u305d\u308c\u305e\u308c 1 \u679a\u3060\u3051\u7f6e\u3044\u3066\u3044\u307e\u3059\u3002\u898b\u305f\u3044\u5185\u5bb9\u306f\u30b0\u30e9\u30d5\u53f3\u4e0a\u306e\u30d7\u30eb\u30c0\u30a6\u30f3\u3067\u5207\u308a\u66ff\u3048\u307e\u3059\u3002</p> \u30b0\u30e9\u30d5 \u5207\u308a\u66ff\u3048\u3089\u308c\u308b\u3082\u306e \u30d7\u30ec\u30a4\u30e4\u30fc\u6bd4\u8f03\uff08\u6a2a\u68d2\uff09 \u6307\u6a19\uff08\u30d7\u30ec\u30a4\u6642\u9593\u3001\u79fb\u52d5\u8ddd\u96e2\u3001\u6b7b\u4ea1\u56de\u6570\u3001\u6483\u7834\u6570\u3001\u63a1\u6398\u6570\u306a\u306918\u7a2e\u985e\uff09\uff0f\u5024\u306e\u57fa\u6e96 \u5185\u8a33\uff08\u6a2a\u68d2\uff09 \u96c6\u8a08\u5bfe\u8c61\uff08\u5012\u3057\u305f mob\u3001\u6b7b\u56e0\u3001\u63a1\u6398\u3001\u30af\u30e9\u30d5\u30c8\u306a\u3069\uff09\uff0f\u5bfe\u8c61\u30d7\u30ec\u30a4\u30e4\u30fc\uff08\u5168\u54e1 / \u500b\u4eba\uff09\uff0f\u5024\u306e\u57fa\u6e96 \u7cfb\u5217\u6bd4\u8f03\uff08\u68d2\uff09 \u6bd4\u8f03\u8ef8\uff08\u79fb\u52d5\u624b\u6bb5\u306e\u5185\u8a33 / \u4e0e\u30c0\u30e1\u30fc\u30b8\u3068\u88ab\u30c0\u30e1\u30fc\u30b8\uff09\uff0f\u5024\u306e\u57fa\u6e96 2\u6307\u6a19\u306e\u95a2\u4fc2\uff08\u6563\u5e03\u56f3\uff09 \u6a2a\u8ef8\u306e\u6307\u6a19\uff0f\u7e26\u8ef8\u306e\u6307\u6a19\uff08\u305d\u308c\u305e\u308c18\u7a2e\u985e\uff09\uff0f\u5024\u306e\u57fa\u6e96 <p>\u300c\u5024\u306e\u57fa\u6e96\u300d\u3067\u3001\u30d7\u30ec\u30a4\u6642\u9593\u306e\u9577\u3055\u306b\u3088\u308b\u5dee\u3092\u9664\u3044\u305f\u6bd4\u8f03\u306b\u5207\u308a\u66ff\u3048\u3089\u308c\u307e\u3059\u3002</p> <ul> <li>\u5b9f\u6570: \u96c6\u8a08\u5024\u305d\u306e\u307e\u307e</li> <li>1\u6642\u9593\u3042\u305f\u308a: \u30d7\u30ec\u30a4\u6642\u9593 1 \u6642\u9593\u3042\u305f\u308a\u306b\u63db\u7b97</li> <li>1\u30d7\u30ec\u30a4\u65e5\u3042\u305f\u308a: \u30d7\u30ec\u30a4\u6642\u9593 24 \u6642\u9593\u3092 1 \u65e5\u3068\u6570\u3048\u3066\u63db\u7b97</li> </ul> <p>\u3044\u305a\u308c\u3082\u30d7\u30ec\u30a4\u6642\u9593\u304c\u5206\u6bcd\u3067\u3059\u3002\u5143\u30c7\u30fc\u30bf\u306b\u96c6\u8a08\u671f\u9593\u304c\u5165\u3063\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u30ab\u30ec\u30f3\u30c0\u30fc\u4e0a\u306e\u7d4c\u904e\u65e5\u6570\u3067\u306e\u63db\u7b97\u306f\u884c\u3063\u3066\u3044\u307e\u305b\u3093\u3002</p> <p>\u753b\u9762\u4e0a\u90e8\u306e\u300c\u7d5e\u308a\u8fbc\u307f\u300d\u3067\u3001\u4efb\u610f\u306e\u6307\u6a19\u306b\u4e0b\u9650\u30fb\u4e0a\u9650\u3092\u8a2d\u3051\u3066\u5bfe\u8c61\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u9650\u5b9a\u3067\u304d\u307e\u3059\uff08\u4f8b: \u30d7\u30ec\u30a4\u6642\u9593 10 \u6642\u9593\u4ee5\u4e0a\uff09\u3002\u7d5e\u308a\u8fbc\u307f\u306f 4 \u30b0\u30e9\u30d5\u3068\u4e0a\u90e8\u306e\u96c6\u8a08\u5024\u3059\u3079\u3066\u306b\u53cd\u6620\u3055\u308c\u307e\u3059\u3002</p> <p>\u5404\u30b0\u30e9\u30d5\u306f\u53f3\u4e0a\u306e\u300c\u8868\u300d\u3067\u8868\u5f62\u5f0f\u306b\u5207\u308a\u66ff\u3048\u3089\u308c\u3001\u305d\u3053\u304b\u3089 CSV \u3068\u3057\u3066\u66f8\u304d\u51fa\u305b\u307e\u3059\u3002</p> <p>\u5225\u306e\u65e5\u306e\u96c6\u8a08\u3092\u898b\u308b\u5834\u5408\u306f\u3001\u753b\u9762\u53f3\u4e0a\u306e \u300cJSON \u3092\u8aad\u307f\u8fbc\u3080\u300d \u304b\u3089\u624b\u5143\u306e <code>minecraft-stats-YYYYMMDD.json</code> \u3092\u9078\u3073\u307e\u3059\u3002\u8aad\u307f\u8fbc\u3093\u3060\u30d5\u30a1\u30a4\u30eb\u306f\u30d6\u30e9\u30a6\u30b6\u5185\u3067\u306e\u307f\u51e6\u7406\u3055\u308c\u3001\u30b5\u30fc\u30d0\u30fc\u3078\u306f\u9001\u4fe1\u3055\u308c\u307e\u305b\u3093\u3002</p>"},{"location":"minecraft/#_2","title":"\u30c7\u30fc\u30bf\u306b\u3064\u3044\u3066\u306e\u6ce8\u610f","text":"<ul> <li><code>combat.kills_by_mob</code> \u306e\u5408\u8a08\u306f <code>combat.mob_kills</code> \u3088\u308a\u5c0f\u3055\u304f\u306a\u308a\u307e\u3059\u3002\u76f4\u63a5\u30ad\u30eb\u306e\u307f\u3092\u6570\u3048\u308b\u96c6\u8a08\u3068\u3001\u843d\u4e0b\u3084\u6eb6\u5ca9\u306b\u3088\u308b\u6483\u7834\u3092\u542b\u3080\u96c6\u8a08\u306e\u9055\u3044\u306b\u3088\u308b\u3082\u306e\u3067\u3059\u3002</li> <li><code>deaths.by_mob</code> \u306b\u8a72\u5f53\u3057\u306a\u3044\u6b7b\u56e0\u306f <code>deaths.other_causes</code> \u306b\u307e\u3068\u3081\u3089\u308c\u3066\u3044\u307e\u3059\u3002</li> <li>\u8ddd\u96e2\u306f cm\u3001\u30c0\u30e1\u30fc\u30b8\u306f 1/10 HP\u3001\u30d7\u30ec\u30a4\u6642\u9593\u306f tick \u304c\u5143\u30c7\u30fc\u30bf\u3067\u3001JSON \u306e\u6642\u70b9\u3067 km\u30fbHP\u30fb\u6642\u9593\u3078\u5909\u63db\u6e08\u307f\u3067\u3059\u3002</li> </ul>"},{"location":"minecraft/#_3","title":"\u69cb\u6210","text":"\u9805\u76ee \u5185\u5bb9 \u5b9f\u88c5 React 19 + Recharts 3\uff08TypeScript / Vite\uff09\u3002\u30bd\u30fc\u30b9\u306f <code>viewer/</code> \u914d\u7f6e <code>docs/apps/index.html</code>\uff08\u76f8\u95a2\u56f3\u3068\u5171\u901a\u306e\u30d3\u30eb\u30c9\u6210\u679c\u7269\uff09 \u898b\u305f\u76ee \u30c9\u30c3\u30c8\u7d75\u98a8\uff08<code>?skin=minecraft</code>\uff09\u3002\u30d7\u30ea\u30bb\u30c3\u30c8\u306f <code>viewer/src/config/skins.ts</code> \u30c7\u30fc\u30bf <code>data/minecraft-stats-20260818.json</code>\uff08\u53d6\u5f97\u5143\u306eAWS\u60c5\u5831\u3068\u30d7\u30ec\u30a4\u30e4\u30fcUUID\u306f\u4f0f\u5b57\uff09\u3092\u30d3\u30eb\u30c9\u6642\u306b\u53d6\u308a\u8fbc\u307f \u51fa\u5178 \u30d3\u30e5\u30fc\u30a2\u306e\u5b9f\u88c5\u3068\u7d71\u8a08\u306f <code>aws_minecraft</code> \u30ea\u30dd\u30b8\u30c8\u30ea\u7531\u6765\u3002\u4ee5\u964d\u306f\u3053\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u3067\u7ba1\u7406"},{"location":"mountaineering/","title":"\u767b\u5c71\u90e8","text":"<p>\u767b\u5c71\u90e8\u306e\u60c5\u5831\u3092\u63b2\u8f09\u3059\u308b\u30da\u30fc\u30b8\u3067\u3059\u3002</p>"},{"location":"mountaineering/#_2","title":"\u6d3b\u52d5\u8a18\u9332","text":"<ul> <li>2026\u5e747\u67084\u65e5 \u5927\u83e9\u85a9\u5dba</li> </ul>"},{"location":"mountaineering/%E6%B4%BB%E5%8B%95%E8%A8%98%E9%8C%B2/20260704/","title":"\u5927\u83e9\u85a9\u5dba","text":"<p>2026\u5e747\u67084\u65e5\u306b\u5927\u83e9\u85a9\u5dba\u3092\u6b69\u3044\u305f\u65e5\u5e30\u308a\u306e\u767b\u5c71\u8a18\u9332\u3067\u3059\u3002</p>"},{"location":"mountaineering/%E6%B4%BB%E5%8B%95%E8%A8%98%E9%8C%B2/20260704/#_2","title":"\u57fa\u672c\u60c5\u5831","text":"\u9805\u76ee \u5185\u5bb9 \u65e5\u7a0b 2026\u5e747\u67084\u65e5\uff08\u571f\uff09 \u30a8\u30ea\u30a2 \u5965\u79e9\u7236\uff08\u5c71\u68a8\u770c\uff09 \u5f62\u5f